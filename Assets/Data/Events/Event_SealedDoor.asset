    - type: 1
      amount: 50
    - type: 4
      amount: 0
  - label: "\uBD80\uC21C\uB2E4"
    resultText: "\uC5B4\uAE68\uB85C \uBC00\uC5B4\uBD99\uC778\uB2E4. \uC1E0\uC0AC\uC2AC\uC774
      \uB04A\uAE30\uBA70 \uC0B4\uC810\uC744 \uAC00\uC838\uAC14\uC9C0\uB9CC, \uC548\uC5D0
      \uC788\uB358 \uAC83\uC740 \uCC59\uACBC\uB2E4."
    effects:
    - type: 3
      amount: 20
    - type: 0
      amount: 40
  - label: "\uB3CC\uC544\uC120\uB2E4"
    resultText: "\uC6B8\uB9BC\uC774 \uC7A6\uC544\uB4E4 \uB54C\uAE4C\uC9C0 \uAE30\uB2E4\uB838\uB2E4\uAC00
