    - type: 2
      amount: 60
  - label: "\uBB34\uAE30\uB97C \uBCF4\uC0B4\uD540\uB2E4"
    resultText: "\uB0A0\uC744 \uC138\uC6B0\uACE0 \uC774\uC74C\uC0C8\uB97C \uC870\uC778\uB2E4.
