  m_Script: {fileID: 11500000, guid: 5b1737562c6ed3a40b1b5b7062a2e966, type: 3}
  m_Name: Event_BrokenAltar
  m_EditorClassIdentifier: 
  eventId: broken_altar
  title: "\uAE68\uC9C4 \uC81C\uB2E8"
  description: "\uBB34\uB108\uC9C4 \uC81C\uB2E8\uC774 \uD76C\uBBF8\uD558\uAC8C \uB9E5\uB3D9\uD55C\uB2E4.
    \uBB34\uC5C7\uC774\uB4E0 \uBC14\uCE58\uBA74 \uC751\uB2F5\uD560 \uAC83 \uAC19\uB2E4."
  choices:
  - label: "\uACF5\uBB3C\uC744 \uBC14\uCE5C\uB2E4"
    resultText: "\uB3D9\uC804\uC774 \uB3CC \uD2C8\uC73C\uB85C \uC0AC\uB77C\uC9C4\uB2E4.
      \uC81C\uB2E8\uC774 \uC7A0\uC2DC \uBC1D\uC544\uC9C0\uB354\uB2C8, \uBA38\uB9BF\uC18D\uC5D0
      \uB0AF\uC120 \uAE30\uC220\uC774 \uC2A4\uBA70\uB4E0\uB2E4."
    effects:
    - type: 1
      amount: 30
    - type: 4
      amount: 0
  - label: "\uD53C\uB97C \uBC14\uCE5C\uB2E4"
    resultText: "\uC190\uBC14\uB2E5\uC744 \uADF8\uC5B4 \uC81C\uB2E8\uC5D0 \uC5B9\uB294\uB2E4.
      \uC0C1\uCC98\uAC00 \uC544\uB9AC\uC9C0\uB9CC, \uB300\uAC00\uB294 \uD655\uC2E4\uD558\uAC8C
      \uB3CC\uC544\uC628\uB2E4."
    effects:
    - type: 3
      amount: 15
    - type: 4
      amount: 0
  - label: "\uADF8\uB0E5 \uC9C0\uB098\uCE5C\uB2E4"
    resultText: "\uC81C\uB2E8\uC740 \uC751\uB2F5\uD558\uC9C0 \uC54A\uC558\uB2E4.
      \uB4F1 \uB4A4\uC5D0\uC11C \uB9E5\uB3D9\uC774 \uC7A6\uC544\uB4E0\uB2E4."
    effects: []
