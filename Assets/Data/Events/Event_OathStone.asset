  eventId: oath_stone
  title: "\uB9F9\uC138\uC758 \uB3CC"
  description: "\uBB34\uB98E \uC790\uAD6D\uC774 \uD30C\uC778 \uB3CC\uC774\uB2E4.
    \uC5EC\uAE30\uC11C \uBB34\uC5B8\uAC00\uB97C \uBC14\uCE5C \uC790\uB4E4\uC774 \uC788\uC5C8\uB2E4."
  choices:
  - label: "\uB9F9\uC138\uB97C \uBC14\uCE5C\uB2E4"
    resultText: "\uC774\uB984\uC744 \uBD80\uB974\uC790 \uB3CC\uC774 \uB370\uC6CC\uC9C4\uB2E4.
      \uAC12\uC744 \uCE58\uB978 \uB9CC\uD07C \uB3CC\uB824\uBC1B\uC558\uB2E4."
    effects:
    - type: 1
      amount: 90
    - type: 4
      amount: 0
  - label: "\uC0C1\uCC98\uB97C \uC53B\uB294\uB2E4"
    resultText: "\uACE0\uC778 \uBB3C\uC5D0 \uC190\uC744 \uB2F4\uADFC\uB2E4. \uCC28\uAC11\uC9C0\uB9CC
      \uC544\uBB3C\uC5B4\uAC04\uB2E4."
    effects:
    - type: 2
      amount: 45
  - label: "\uBB34\uB98E\uC744 \uAFC7\uC9C0 \uC54A\uB294\uB2E4"
    resultText: "\uB3CC\uC740 \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4.
      \uADF8\uD3B8\uC774 \uB098\uC558\uB2E4."
