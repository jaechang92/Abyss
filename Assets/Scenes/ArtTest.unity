--- !u!102 &236159022
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 236159021}
  m_Text: "stage1 \uC544\uD2B8 \uD14C\uC2A4\uD2B8 \u2014 \uBC29\uD5A5\uD0A4 \uC774\uB3D9 \xB7 Q/E \uD655\uB300 \xB7 R \uC6D0\uC704\uCE58\nPPU 32  (\uD0C0\uC77C 32px = 1\uC720\uB2DB,  \uD50C\uB808\uC774\uC5B4 2\uC720\uB2DB = 64px)\n\uCE74\uBA54\uB77C ortho 5  \u2192  \uD654\uBA74 17.8 x 10 \uC720\uB2DB\n\uBC30\uACBD 160x96 = 5 x 3 \uC720\uB2DB  \u2192  x4 \uD655\uB300\uD574 20 x 12 \uC720\uB2DB\n\u26A0 \uADF8\uB798\uC11C \uBC30\uACBD \uD53D\uC140\uC774 \uD504\uB86D \uD53D\uC140\uBCF4\uB2E4 4\uBC30 \uD06C\uB2E4 \u2014 \uAC70\uC2AC\uB9AC\uBA74 \uBC30\uACBD\uC744 \uD06C\uAC8C \uB2E4\uC2DC \uBF51\uC544\uC57C \uD55C\uB2E4\n\uD310\uC815: \u2460 x=0 \uC774\uC74C\uB9E4\uC5D0\uC11C \uBCBD/\uC9C0\uBA74\uC774 \uAC08\uB9AC\uB294\uAC00  \u2461 \uBC30\uACBD \uD53D\uC140 \uD06C\uAE30  \u2462 bg_near 1px  \u2463 \uBC14\uB2E5\uC774 \uCE90\uB9AD\uD130\uB97C \uBA39\uB294\uAC00"
  m_OffsetZ: 0
  m_CharacterSize: 0.22
  m_LineSpacing: 1
  m_Anchor: 0
  m_Alignment: 0
  m_TabSize: 4
  m_FontSize: 64
